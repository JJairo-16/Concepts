<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MenuLevelTitle">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/menu_title_text_size</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="MenuBrushButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/brush_button_height</item>
        <item name="android:background">@drawable/bg_brush</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">@dimen/brush_text_size</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingStart">@dimen/menu_button_padding_h</item>
        <item name="android:paddingEnd">@dimen/menu_button_padding_h</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:elevation">@dimen/menu_button_elevation</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="MenuReturnButton" parent="MenuBrushButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/return_button_height</item>
        <item name="android:background">@drawable/bg_brush_exit</item>
        <item name="android:textSize">@dimen/return_text_size</item>
        <item name="android:textColor">@color/menu_text_dark</item>
        <item name="android:backgroundTint">@color/color_green</item>
    </style>

    <style name="MenuLevelBrushButton" parent="MenuBrushButton">
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">@dimen/level_button_min_text_size</item>
        <item name="autoSizeMaxTextSize">@dimen/level_button_max_text_size</item>
        <item name="autoSizeStepGranularity">@dimen/autosize_step</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="MenuActivityButton" parent="MenuBrushButton">
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">@dimen/autosize_min_text_size</item>
        <item name="autoSizeMaxTextSize">@dimen/autosize_max_text_size</item>
        <item name="autoSizeStepGranularity">@dimen/autosize_step</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">@dimen/menu_activity_padding_h</item>
        <item name="android:paddingEnd">@dimen/menu_activity_padding_h</item>
    </style>

</resources>
