<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu"
    tools:context=".MainActivity">

    <!-- Decorative background blobs -->
    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_yellow"
        android:translationX="@dimen/blob_offset_x_neg"
        android:translationY="@dimen/blob_offset_y_neg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_pink"
        android:translationX="@dimen/blob_offset_x"
        android:translationY="@dimen/blob_offset_y_neg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_small_width"
        android:layout_height="@dimen/blob_small_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_blue"
        android:translationX="@dimen/blob_small_offset_x_neg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_small_width"
        android:layout_height="@dimen/blob_small_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_peach"
        android:translationX="@dimen/blob_small_offset_x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_green"
        android:translationX="@dimen/blob_offset_x_neg"
        android:translationY="@dimen/blob_bottom_offset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_lavender"
        android:translationX="@dimen/blob_offset_x"
        android:translationY="@dimen/blob_bottom_offset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.79" />

    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/logo_margin_top"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_concepts"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="@dimen/logo_max_height"
        app:layout_constraintHeight_min="@dimen/logo_min_height"
        app:layout_constraintHeight_percent="0.32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btn_i3"
        style="@style/MenuLevelBrushButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/menu_button_margin_top"
        android:backgroundTint="@color/color_red"
        android:text="@string/menu_i3_title"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="@dimen/menu_button_max_height"
        app:layout_constraintHeight_min="@dimen/menu_button_min_height"
        app:layout_constraintHeight_percent="0.11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_logo"
        app:layout_constraintWidth_percent="0.64" />

    <TextView
        android:id="@+id/btn_i4"
        style="@style/MenuLevelBrushButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/menu_button_margin_top"
        android:backgroundTint="@color/color_orange"
        android:text="@string/menu_i4_title"
        android:textColor="@color/menu_text_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="@dimen/menu_button_max_height"
        app:layout_constraintHeight_min="@dimen/menu_button_min_height"
        app:layout_constraintHeight_percent="0.11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_i3"
        app:layout_constraintWidth_percent="0.64" />

    <TextView
        android:id="@+id/btn_i5"
        style="@style/MenuLevelBrushButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/menu_button_margin_top"
        android:backgroundTint="@color/color_purple"
        android:text="@string/menu_i5_title"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="@dimen/menu_button_max_height"
        app:layout_constraintHeight_min="@dimen/menu_button_min_height"
        app:layout_constraintHeight_percent="0.11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_i4"
        app:layout_constraintWidth_percent="0.64" />

    <FrameLayout
        android:id="@+id/btn_exit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_brush_exit"
        android:backgroundTint="@color/color_green"
        android:clickable="true"
        android:elevation="@dimen/menu_button_elevation"
        android:focusable="true"
        android:stateListAnimator="@null"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="@dimen/start_button_max_height"
        app:layout_constraintHeight_min="@dimen/start_button_min_height"
        app:layout_constraintHeight_percent="0.09"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline_start">

        <ImageView
            android:layout_width="@dimen/start_arrow_size"
            android:layout_height="@dimen/start_arrow_size"
            android:layout_gravity="center"
            android:contentDescription="@string/menu_exit"
            android:src="@drawable/ic_arrow_next" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
