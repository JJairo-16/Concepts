<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu"
    tools:context=".MenuI4Activity">

    <!-- Decorative background blobs -->
    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_yellow"
        android:translationX="@dimen/blob_offset_x_neg"
        android:translationY="@dimen/blob_offset_y_neg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_pink"
        android:translationX="@dimen/blob_offset_x"
        android:translationY="@dimen/blob_offset_y_neg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_small_width"
        android:layout_height="@dimen/blob_small_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_blue"
        android:translationX="@dimen/blob_small_offset_x_neg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_small_width"
        android:layout_height="@dimen/blob_small_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_peach"
        android:translationX="@dimen/blob_small_offset_x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_green"
        android:translationX="@dimen/blob_offset_x_neg"
        android:translationY="@dimen/blob_bottom_offset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_lavender"
        android:translationX="@dimen/blob_offset_x"
        android:translationY="@dimen/blob_bottom_offset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.14" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_return"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.8" />

    <TextView
        android:id="@+id/tv_menu_title"
        style="@style/MenuLevelTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_i4_title"
        android:textColor="@color/color_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline_title" />

    <LinearLayout
        android:id="@+id/options_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.52"
        app:layout_constraintWidth_percent="0.64">

        <TextView
            android:id="@+id/btn_activity_1"
            style="@style/MenuActivityButton"
            android:layout_height="@dimen/activity_button_height"
            android:backgroundTint="@color/color_orange"
            android:text="@string/menu_i4_activity_1"
            android:textColor="@color/menu_text_dark" />

        <TextView
            android:id="@+id/btn_activity_2"
            style="@style/MenuActivityButton"
            android:layout_height="@dimen/activity_button_height"
            android:layout_marginTop="@dimen/activity_button_spacing"
            android:backgroundTint="@color/color_orange"
            android:text="@string/menu_i4_activity_2"
            android:textColor="@color/menu_text_dark" />

    </LinearLayout>

    <TextView
        android:id="@+id/btn_return"
        style="@style/MenuReturnButton"
        android:text="@string/menu_return"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline_return"
        app:layout_constraintWidth_percent="0.28" />

</androidx.constraintlayout.widget.ConstraintLayout>
