<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/find_colour_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu">

    <!-- Decorative background blobs -->
    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_yellow"
        android:translationX="@dimen/blob_offset_x_neg"
        android:translationY="@dimen/blob_offset_y_neg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_pink"
        android:translationX="@dimen/blob_offset_x"
        android:translationY="@dimen/blob_offset_y_neg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_small_width"
        android:layout_height="@dimen/blob_small_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_blue"
        android:translationX="@dimen/blob_small_offset_x_neg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_small_width"
        android:layout_height="@dimen/blob_small_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_peach"
        android:translationX="@dimen/blob_small_offset_x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_green"
        android:translationX="@dimen/blob_offset_x_neg"
        android:translationY="@dimen/blob_bottom_offset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_lavender"
        android:translationX="@dimen/blob_offset_x"
        android:translationY="@dimen/blob_bottom_offset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Guides (percentages taken from the original mockup) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start_x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.10" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.148" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.205" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_scene_x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.365" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_scene_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.875" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_card_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.33" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.80" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_find_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/game_title_margin_end"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/find_colour_title"
        android:textColor="@color/game_i3_brown"
        android:textSize="@dimen/game_title_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline_start_x"
        app:layout_constraintTop_toTopOf="@id/guideline_title" />

    <!-- Instruction -->
    <TextView
        android:id="@+id/tv_find_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/find_colour_instruction"
        android:textColor="@color/game_i3_text"
        android:textSize="@dimen/game_instruction_text_size"
        app:layout_constraintStart_toStartOf="@id/guideline_start_x"
        app:layout_constraintTop_toTopOf="@id/guideline_subtitle" />

    <!-- Speaker card -->
    <FrameLayout
        android:id="@+id/card_find_speaker"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_find_card"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/guideline_card_end"
        app:layout_constraintStart_toStartOf="@id/guideline_start_x"
        app:layout_constraintTop_toTopOf="@id/guideline_content">

        <ImageView
            android:id="@+id/iv_find_speaker"
            android:layout_width="@dimen/find_speaker_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/find_colour_speaker"
            android:src="@drawable/ic_listen" />

    </FrameLayout>

    <!-- Scene (empty slot: the image is set later with android:src or setImageResource) -->
    <com.example.concepts.FindColourSceneView
        android:id="@+id/iv_find_scene"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_find_scene"
        android:contentDescription="@string/find_colour_scene_desc"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="1000:614"
        app:layout_constraintEnd_toStartOf="@id/guideline_scene_end"
        app:layout_constraintStart_toStartOf="@id/guideline_scene_x"
        app:layout_constraintTop_toTopOf="@id/guideline_content" />

    <!-- Caption -->

    <!-- Return -->
    <TextView
        android:id="@+id/btn_return"
        style="@style/MenuReturnButton"
        android:layout_marginEnd="@dimen/game_return_margin_end"
        android:layout_marginBottom="@dimen/game_return_margin_bottom"
        android:text="@string/menu_return"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.28" />

</androidx.constraintlayout.widget.ConstraintLayout>
