<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/listen_click_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu">

    <!-- Decorative background blobs -->
    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_yellow"
        android:translationX="@dimen/blob_offset_x_neg"
        android:translationY="@dimen/blob_offset_y_neg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_pink"
        android:translationX="@dimen/blob_offset_x"
        android:translationY="@dimen/blob_offset_y_neg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_small_width"
        android:layout_height="@dimen/blob_small_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_blue"
        android:translationX="@dimen/blob_small_offset_x_neg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_small_width"
        android:layout_height="@dimen/blob_small_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_peach"
        android:translationX="@dimen/blob_small_offset_x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_green"
        android:translationX="@dimen/blob_offset_x_neg"
        android:translationY="@dimen/blob_bottom_offset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="@dimen/blob_large_width"
        android:layout_height="@dimen/blob_large_height"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob"
        app:tint="@color/blob_lavender"
        android:translationX="@dimen/blob_offset_x"
        android:translationY="@dimen/blob_bottom_offset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Guides (percentages taken from the original mockup) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start_x"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.10" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.148" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_speaker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.195" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_colors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.51" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_again"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.70" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_listen_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/game_title_margin_end"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/listen_click_title"
        android:textColor="@color/game_i3_brown"
        android:textSize="@dimen/game_title_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline_start_x"
        app:layout_constraintTop_toTopOf="@id/guideline_title" />

    <!-- Instruction -->
    <TextView
        android:id="@+id/tv_listen_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/listen_click_instruction"
        android:textColor="@color/game_i3_text"
        android:textSize="@dimen/game_instruction_text_size"
        app:layout_constraintStart_toStartOf="@id/guideline_start_x"
        app:layout_constraintTop_toTopOf="@id/guideline_subtitle" />

    <!-- Speaker -->
    <ImageView
        android:id="@+id/iv_listen_icon"
        android:layout_width="@dimen/listen_icon_width"
        android:layout_height="@dimen/listen_icon_height"
        android:contentDescription="@string/listen_click_speaker"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_listen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline_speaker" />

    <!-- Clickable colour blobs -->
    <LinearLayout
        android:id="@+id/colors_row"
        android:layout_width="0dp"
        android:layout_height="@dimen/game_colors_row_height"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline_colors"
        app:layout_constraintWidth_percent="0.623">

        <ImageView
            android:id="@+id/iv_color_red"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/game_i3_color_red"
            android:scaleType="fitCenter"
            android:src="@drawable/i3_blob_red" />

        <ImageView
            android:id="@+id/iv_color_orange"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/game_i3_color_orange"
            android:scaleType="fitCenter"
            android:src="@drawable/i3_blob_orange" />

        <ImageView
            android:id="@+id/iv_color_yellow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/game_i3_color_yellow"
            android:scaleType="fitCenter"
            android:src="@drawable/i3_blob_yellow" />

        <ImageView
            android:id="@+id/iv_color_green"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/game_i3_color_green"
            android:scaleType="fitCenter"
            android:src="@drawable/i3_blob_green" />

        <ImageView
            android:id="@+id/iv_color_blue"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/game_i3_color_blue"
            android:scaleType="fitCenter"
            android:src="@drawable/i3_blob_blue" />

    </LinearLayout>

    <!-- Repeat the sound -->
    <TextView
        android:id="@+id/btn_again"
        android:layout_width="@dimen/again_button_width"
        android:layout_height="@dimen/again_button_height"
        android:background="@drawable/bg_again"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/listen_click_again"
        android:textColor="@color/white"
        android:textSize="@dimen/again_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline_again" />

    <!-- Return -->
    <TextView
        android:id="@+id/btn_return"
        style="@style/MenuReturnButton"
        android:layout_marginEnd="@dimen/game_return_margin_end"
        android:layout_marginBottom="@dimen/game_return_margin_bottom"
        android:text="@string/menu_return"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.28" />

</androidx.constraintlayout.widget.ConstraintLayout>
